{
  "expo": {
    "name": "Merge Bazaar",
    "slug": "merge-bazaar-festival-homes",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.jeetech.mergebazaar",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.jeetech.mergebazaar",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "scheme": "merge-bazaar-festival-homes",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ]
    ]
  }
}
